  <!-- Plus Jakarta Sans Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-base: #faf8fa;
    }
    html, body {
      overflow-x: hidden;
      width: 100%;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: var(--bg-base);
      color: #0f172a;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* =========================================================================
       ZERO-LAG 60FPS GRADIENT MESH ENGINE
       Uses multi-stop radial gradient feathering instead of heavy gaussian blurs
       (Takes 0ms GPU convolution time, eliminating all scrolling lag)
       ========================================================================= */
    .animated-mesh-container {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
      background: #faf8fa;
    }

    .mesh-palette-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
      transform: translate3d(0, 0, 0);
      will-change: opacity;
    }

    .mesh-orb {
      position: absolute;
      border-radius: 9999px;
      pointer-events: none;
      will-change: transform;
    }

    /* Layer 1: Starting Cool Palette (Icy Cyan, Sky Blue, Periwinkle & Mint) */
    .layer-1 .orb-1 {
      top: -5%;
      left: 10%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(56, 189, 248, 0.42) 0%, rgba(56, 189, 248, 0.2) 35%, rgba(56, 189, 248, 0.05) 60%, transparent 72%);
      animation: floatOrb1 20s ease-in-out infinite alternate;
    }
    .layer-1 .orb-2 {
      top: 15%;
      right: 5%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle at center, rgba(129, 140, 248, 0.38) 0%, rgba(129, 140, 248, 0.18) 35%, rgba(129, 140, 248, 0.04) 60%, transparent 72%);
      animation: floatOrb2 24s ease-in-out infinite alternate;
    }
    .layer-1 .orb-3 {
      top: 40%;
      left: 20%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(167, 139, 250, 0.32) 0%, rgba(167, 139, 250, 0.14) 35%, rgba(167, 139, 250, 0.03) 60%, transparent 72%);
      animation: floatOrb3 26s ease-in-out infinite alternate;
    }
    .layer-1 .orb-4 {
      top: 60%;
      right: 15%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(45, 212, 191, 0.32) 0%, rgba(45, 212, 191, 0.14) 35%, rgba(45, 212, 191, 0.03) 60%, transparent 72%);
      animation: floatOrb1 22s ease-in-out infinite alternate reverse;
    }

    /* Layer 2: Solutions & Apps Palette (Warm Rose, Peach & Soft Fuchsia) */
    .layer-2 .orb-1 {
      top: 0%;
      left: 10%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(244, 114, 182, 0.42) 0%, rgba(244, 114, 182, 0.2) 35%, rgba(244, 114, 182, 0.05) 60%, transparent 72%);
      animation: floatOrb1 20s ease-in-out infinite alternate;
    }
    .layer-2 .orb-2 {
      top: 15%;
      right: 5%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle at center, rgba(251, 113, 133, 0.38) 0%, rgba(251, 113, 133, 0.18) 35%, rgba(251, 113, 133, 0.04) 60%, transparent 72%);
      animation: floatOrb2 24s ease-in-out infinite alternate;
    }
    .layer-2 .orb-3 {
      top: 35%;
      left: 20%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(233, 213, 255, 0.4) 0%, rgba(233, 213, 255, 0.18) 35%, rgba(233, 213, 255, 0.04) 60%, transparent 72%);
      animation: floatOrb3 26s ease-in-out infinite alternate;
    }
    .layer-2 .orb-4 {
      top: 55%;
      right: 15%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(186, 230, 253, 0.35) 0%, rgba(186, 230, 253, 0.15) 35%, rgba(186, 230, 253, 0.03) 60%, transparent 72%);
      animation: floatOrb1 22s ease-in-out infinite alternate reverse;
    }

    /* Layer 3: Services & Comparison Palette (Warm Amber, Sunset Gold & Coral) */
    .layer-3 .orb-1 {
      top: 0%;
      left: 10%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(245, 158, 11, 0.38) 0%, rgba(245, 158, 11, 0.18) 35%, rgba(245, 158, 11, 0.04) 60%, transparent 72%);
      animation: floatOrb1 20s ease-in-out infinite alternate;
    }
    .layer-3 .orb-2 {
      top: 15%;
      right: 5%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle at center, rgba(234, 88, 12, 0.35) 0%, rgba(234, 88, 12, 0.16) 35%, rgba(234, 88, 12, 0.04) 60%, transparent 72%);
      animation: floatOrb2 24s ease-in-out infinite alternate;
    }
    .layer-3 .orb-3 {
      top: 35%;
      left: 20%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(248, 113, 113, 0.35) 0%, rgba(248, 113, 113, 0.15) 35%, rgba(248, 113, 113, 0.03) 60%, transparent 72%);
      animation: floatOrb3 26s ease-in-out infinite alternate;
    }
    .layer-3 .orb-4 {
      top: 55%;
      right: 15%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(16, 185, 129, 0.32) 0%, rgba(16, 185, 129, 0.14) 35%, rgba(16, 185, 129, 0.03) 60%, transparent 72%);
      animation: floatOrb1 22s ease-in-out infinite alternate reverse;
    }

    /* Layer 4: NFC Hardware & Contact (Royal Violet, Fuchsia & Electric Orchid) */
    .layer-4 .orb-1 {
      top: 0%;
      left: 10%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(217, 70, 239, 0.4) 0%, rgba(217, 70, 239, 0.18) 35%, rgba(217, 70, 239, 0.04) 60%, transparent 72%);
      animation: floatOrb1 20s ease-in-out infinite alternate;
    }
    .layer-4 .orb-2 {
      top: 15%;
      right: 5%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle at center, rgba(139, 92, 246, 0.38) 0%, rgba(139, 92, 246, 0.18) 35%, rgba(139, 92, 246, 0.04) 60%, transparent 72%);
      animation: floatOrb2 24s ease-in-out infinite alternate;
    }
    .layer-4 .orb-3 {
      top: 35%;
      left: 20%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(2, 132, 199, 0.35) 0%, rgba(2, 132, 199, 0.15) 35%, rgba(2, 132, 199, 0.03) 60%, transparent 72%);
      animation: floatOrb3 26s ease-in-out infinite alternate;
    }
    .layer-4 .orb-4 {
      top: 55%;
      right: 15%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle at center, rgba(219, 39, 119, 0.35) 0%, rgba(219, 39, 119, 0.15) 35%, rgba(219, 39, 119, 0.03) 60%, transparent 72%);
      animation: floatOrb1 22s ease-in-out infinite alternate reverse;
    }

    @keyframes floatOrb1 {
      0% { transform: translate(0px, 0px) scale(1); }
      50% { transform: translate(70px, 90px) scale(1.1); }
      100% { transform: translate(-60px, 40px) scale(0.92); }
    }
    @keyframes floatOrb2 {
      0% { transform: translate(0px, 0px) scale(1); }
      50% { transform: translate(-80px, 60px) scale(0.9); }
      100% { transform: translate(60px, -70px) scale(1.1); }
    }
    @keyframes floatOrb3 {
      0% { transform: translate(0px, 0px) scale(0.95); }
      50% { transform: translate(60px, -60px) scale(1.08); }
      100% { transform: translate(-50px, 70px) scale(1); }
    }

    /* Ambient Subtle Grid Pattern Overlay */
    .mesh-grid-overlay {
      position: absolute;
      inset: 0;
      background-image: 
        radial-gradient(circle at center, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
      background-size: 32px 32px;
      opacity: 0.65;
      pointer-events: none;
    }

    /* Lightweight Glass Panels (Optimized for 60FPS) */
    .glass-panel {
      background: rgba(255, 255, 255, 0.82);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.95);
      box-shadow: 
        0 10px 28px -10px rgba(15, 23, 42, 0.05),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
      transition: background-color 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .glass-panel:hover {
      background: rgba(255, 255, 255, 0.92);
      border-color: rgba(255, 255, 255, 1);
      box-shadow: 
        0 16px 36px -10px rgba(15, 23, 42, 0.08),
        0 0 0 1px rgba(255, 255, 255, 0.95) inset;
      transform: translateY(-2px);
    }

    /* =========================================================================
       CLICKABLE CARDS VS STATIC READABLE CARDS DIFFERENTIATION
       Clickable cards change color smoothly on cursor hover with distinct pastel
       brand accents, pointer cursor, and subtle elevation glow.
       Static cards remain calm neutral white/glass with default cursor.
       ========================================================================= */
    .card-static {
      cursor: default;
    }
    .card-static:hover {
      background: rgba(255, 255, 255, 0.85);
      border-color: rgba(255, 255, 255, 0.95);
      box-shadow: 0 10px 28px -10px rgba(15, 23, 42, 0.05);
      transform: none;
    }

    .card-clickable {
      cursor: pointer;
      position: relative;
    }

    /* SiteMaker: Rose Hue Hover */
    .card-clickable-rose:hover {
      background: rgba(255, 241, 242, 0.92) !important;
      border-color: rgba(244, 63, 94, 0.4) !important;
      box-shadow: 
        0 18px 38px -10px rgba(244, 63, 94, 0.18),
        0 0 0 1px rgba(244, 63, 94, 0.2) inset !important;
      transform: translateY(-3px);
    }

    /* LeadsFlowPro: Indigo Hue Hover */
    .card-clickable-indigo:hover {
      background: rgba(238, 242, 255, 0.92) !important;
      border-color: rgba(99, 102, 241, 0.4) !important;
      box-shadow: 
        0 18px 38px -10px rgba(99, 102, 241, 0.18),
        0 0 0 1px rgba(99, 102, 241, 0.2) inset !important;
      transform: translateY(-3px);
    }

    /* Smart NFC: Amber Hue Hover */
    .card-clickable-amber:hover {
      background: rgba(254, 243, 199, 0.92) !important;
      border-color: rgba(245, 158, 11, 0.45) !important;
      box-shadow: 
        0 18px 38px -10px rgba(245, 158, 11, 0.18),
        0 0 0 1px rgba(245, 158, 11, 0.2) inset !important;
      transform: translateY(-3px);
    }

    /* StarScanner: Cyan Hue Hover */
    .card-clickable-cyan:hover {
      background: rgba(236, 254, 255, 0.92) !important;
      border-color: rgba(6, 182, 212, 0.4) !important;
      box-shadow: 
        0 18px 38px -10px rgba(6, 182, 212, 0.18),
        0 0 0 1px rgba(6, 182, 212, 0.2) inset !important;
      transform: translateY(-3px);
    }

    /* WhatsApp: Emerald Hue Hover */
    .card-clickable-emerald:hover {
      background: rgba(236, 253, 245, 0.94) !important;
      border-color: rgba(16, 185, 129, 0.45) !important;
      box-shadow: 
        0 18px 38px -10px rgba(16, 185, 129, 0.18),
        0 0 0 1px rgba(16, 185, 129, 0.2) inset !important;
      transform: translateY(-3px);
    }

    /* Work Email: Pink Hue Hover */
    .card-clickable-pink:hover {
      background: rgba(253, 242, 248, 0.94) !important;
      border-color: rgba(236, 72, 153, 0.42) !important;
      box-shadow: 
        0 18px 38px -10px rgba(236, 72, 153, 0.18),
        0 0 0 1px rgba(236, 72, 153, 0.2) inset !important;
      transform: translateY(-3px);
    }

    /* Instagram: Purple Hue Hover */
    .card-clickable-purple:hover {
      background: rgba(250, 245, 255, 0.94) !important;
      border-color: rgba(168, 85, 247, 0.45) !important;
      box-shadow: 
        0 18px 38px -10px rgba(168, 85, 247, 0.18),
        0 0 0 1px rgba(168, 85, 247, 0.2) inset !important;
      transform: translateY(-3px);
    }

    /* Mobile Touch Feedback & GPU Optimization */
    .card-clickable:active {
      transform: scale(0.985) !important;
      transition: transform 0.1s ease;
    }
    .pill-button:active {
      transform: scale(0.97) !important;
    }

    @media (max-width: 640px) {
      .mesh-orb {
        width: 380px !important;
        height: 380px !important;
      }
      .title-display {
        letter-spacing: -0.025em;
      }
    }

    .glass-nav {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.9);
    }

    .title-display {
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.15;
    }

    .pill-button {
      background: #0f172a;
      color: #ffffff;
      border-radius: 9999px;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    }
    .pill-button:hover {
      background: #1e293b;
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    }
  </style>
</head>
<body class="min-h-screen">

  <!-- =========================================================================
       ZERO-LAG 60FPS GRADIENT MESH ENGINE
       ========================================================================= -->
  <div class="animated-mesh-container">
    <!-- Mesh Layer 1: Cool Icy Cyan & Indigo (Active at top) -->
    <div id="mesh-layer-1" class="mesh-palette-layer layer-1">
      <div class="mesh-orb orb-1"></div>
      <div class="mesh-orb orb-2"></div>
      <div class="mesh-orb orb-3"></div>
      <div class="mesh-orb orb-4"></div>
    </div>

    <!-- Mesh Layer 2: Solutions Warm Rose & Peach (Fades in smoothly) -->
    <div id="mesh-layer-2" class="mesh-palette-layer layer-2 opacity-0">
      <div class="mesh-orb orb-1"></div>
      <div class="mesh-orb orb-2"></div>
      <div class="mesh-orb orb-3"></div>
      <div class="mesh-orb orb-4"></div>
    </div>

    <!-- Mesh Layer 3: Services Warm Amber & Sunset Gold -->
    <div id="mesh-layer-3" class="mesh-palette-layer layer-3 opacity-0">
      <div class="mesh-orb orb-1"></div>
      <div class="mesh-orb orb-2"></div>
      <div class="mesh-orb orb-3"></div>
      <div class="mesh-orb orb-4"></div>
    </div>

    <!-- Mesh Layer 4: NFC Hardware & Contact Royal Violet & Orchid -->
    <div id="mesh-layer-4" class="mesh-palette-layer layer-4 opacity-0">
      <div class="mesh-orb orb-1"></div>
      <div class="mesh-orb orb-2"></div>
      <div class="mesh-orb orb-3"></div>
      <div class="mesh-orb orb-4"></div>
    </div>

    <div class="mesh-grid-overlay"></div>
  </div>

  <!-- Redesigned Minimalist 64px Header with Mobile Drawer -->
  <header class="sticky top-0 z-50 glass-nav">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 h-16 flex items-center justify-between">
      
      <!-- Brand Logo (Clean Emblem + Name Only) -->
      <a href="index.html" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-white/95 border border-slate-200/90 shadow-xs flex items-center justify-center p-1.5 transition-transform group-hover:scale-105 duration-200">
          <svg viewBox="0 0 512 512" class="w-full h-full" fill="none">
            <defs>
              <linearGradient id="nav-brand-pink" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff2e93"/>
                <stop offset="100%" stop-color="#ec4899"/>
              </linearGradient>
            </defs>
            <path d="M 245 150 C 215 150, 185 170, 185 210 V 360" fill="none" stroke="#0f172a" stroke-width="42" stroke-linecap="round"/>
            <path d="M 140 235 H 275 C 335 235, 365 260, 365 300 C 365 342, 325 365, 275 365 C 230 365, 205 340, 205 305" fill="none" stroke="#0f172a" stroke-width="42" stroke-linecap="round"/>
            <circle cx="410" cy="350" r="28" fill="url(#nav-brand-pink)"/>
          </svg>
        </div>
        <span class="text-base sm:text-lg font-bold tracking-tight text-slate-950 font-sans">FlowCraft <span class="text-pink-600">Studio</span></span>
      </a>

