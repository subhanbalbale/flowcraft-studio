  <!-- =========================================================================
       HYPERFRAMES 60FPS MOTION & CONTINUOUS FULL-PAGE SCROLL GRADIENT SCRIPT
       ========================================================================= -->
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      // Mobile Navigation Drawer Toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', () => {
          const isOpen = !mobileMenu.classList.contains('hidden');
          if (isOpen) {
            mobileMenu.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          } else {
            mobileMenu.classList.remove('hidden');
            hamburgerIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
          }
        });

        // Close mobile drawer when clicking navigation links
        document.querySelectorAll('.mobile-nav-link').forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          });
        });
      }

      // 1. Soft Cinematic Blur Entrances for Hero
      const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.7 } });

      tl.fromTo('#hero-badge', { opacity: 0, y: 16, filter: 'blur(6px)' }, { opacity: 1, y: 0, filter: 'blur(0px)' })
        .fromTo('#hero-title', { opacity: 0, y: 22, filter: 'blur(8px)' }, { opacity: 1, y: 0, filter: 'blur(0px)' }, '-=0.45')
        .fromTo('#hero-subhead', { opacity: 0, y: 16, filter: 'blur(5px)' }, { opacity: 1, y: 0, filter: 'blur(0px)' }, '-=0.45')
        .fromTo('#hero-cta', { opacity: 0, y: 14, filter: 'blur(4px)' }, { opacity: 1, y: 0, filter: 'blur(0px)' }, '-=0.45')
        .fromTo('#hero-metrics', { opacity: 0, y: 14, filter: 'blur(4px)' }, { opacity: 1, y: 0, filter: 'blur(0px)' }, '-=0.35');

      // Living Ambient Drift on Hero Title
      gsap.to('#hero-title', {
        y: -4,
        duration: 3.5,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true
      });

      // 2. Continuous Silky-Smooth Scroll-Driven Gradient Palette Scrubbing
      if (typeof ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);

        // Pre-set exact initial states
        gsap.set('#mesh-layer-1', { opacity: 1 });
        gsap.set('#mesh-layer-2', { opacity: 0 });
        gsap.set('#mesh-layer-3', { opacity: 0 });
        gsap.set('#mesh-layer-4', { opacity: 0 });

        const meshTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: document.body,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1.2,
            invalidateOnRefresh: true
          }
        });

        // Continuous full-page scroll progress (0 to 3 units)
        meshTimeline
          .to('#mesh-layer-1', { opacity: 0, ease: 'sine.inOut' }, 0)
          .to('#mesh-layer-2', { opacity: 1, ease: 'sine.inOut' }, 0)
          .to('#mesh-layer-2', { opacity: 0, ease: 'sine.inOut' }, 1)
          .to('#mesh-layer-3', { opacity: 1, ease: 'sine.inOut' }, 1)
          .to('#mesh-layer-3', { opacity: 0, ease: 'sine.inOut' }, 2)
          .to('#mesh-layer-4', { opacity: 1, ease: 'sine.inOut' }, 2);
      }
    });
  </script>
</body>
</html>
